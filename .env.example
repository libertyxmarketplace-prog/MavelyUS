# Discord Bot Credentials
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE
CLIENT_ID=YOUR_CLIENT_ID_HERE
# Optional Guild ID for instant slash command registration (recommended during setup)
GUILD_ID=YOUR_GUILD_ID_HERE

# Discord OAuth2 (create these in the Discord Developer Portal)
DISCORD_CLIENT_ID=YOUR_OAUTH_APPLICATION_ID_HERE
DISCORD_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET_HERE
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
APP_ORIGIN=http://localhost:3000

# Optional ER:LC key for the central bot's existing session panels
ERLC_API_KEY=YOUR_ERLC_SERVER_KEY_HERE
