# Discord application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=1552165138017165372
DISCORD_CLIENT_SECRET=

# Public URL of the site. Redirect URI becomes BASE_URL/auth/discord/callback
# Local: http://localhost:3000   Production: https://civlink.xyz
BASE_URL=http://localhost:3000

# Long random string. Also used to encrypt saved bot tokens, so do not change it after launch.
SESSION_SECRET=

# API port. In production the API also serves the built site on this port.
PORT=3001
